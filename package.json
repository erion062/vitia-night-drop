{
  "name": "vitia-night-drop",
  "private": true,
  "version": "1.0.0",
  "description": "VITIA NIGHT DROP (VND) - late-night on-demand delivery PWA for Viti, Kosovo",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.js",
    "icons": "node scripts/make-icons.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "zip": "node scripts/make-update-zip.mjs",
    "zip:launch": "node scripts/make-launch-zip.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "leaflet": "1.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
