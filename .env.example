# Copy to .env on the server. Never commit a real .env.

NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# SQLite file and product photos (keep this folder backed up).
# On Hostinger Git deploys, data/vnd.db sits inside the wiped build folder, so
# the app stores the shop in persistent/ next to hbuilds instead. Leave these
# as-is locally. Only override with an absolute path outside hbuilds.
DB_PATH=data/vnd.db
UPLOADS_DIR=data/uploads

# Your real admin login (password min 10 characters in production)
ADMIN_PHONE=044000000
ADMIN_PASSWORD=change-this-to-a-long-password
ADMIN_NAME=Whitey
# Set to true once, start the app, then remove it — it resets the admin password
# ADMIN_RESET_PASSWORD=true

# Optional partner logins (the shops themselves stay in the database)
# SOFRA_PHONE=
# SOFRA_PASSWORD=
# SOFRA_NAME=Furra Sofra

# Your live site, no trailing slash. Needed for cookies / login on HTTPS.
ALLOWED_ORIGINS=https://vnd.com

# Leave empty unless you have a CARTO basemap key (maps still work without it)
CARTO_API_KEY=

# Behind Hostinger / nginx / LiteSpeed
TRUST_PROXY=true
COOKIE_SECURE=true

# Optional routing. Default is the public OSRM demo (not for heavy traffic).
# OSRM_URL=https://router.project-osrm.org

# Never set this on the live server. Simulation is ignored when NODE_ENV=production.
# ENABLE_SIMULATION=true
